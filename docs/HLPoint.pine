//@version=6
indicator("Confirmed Pivot ZigZag", overlay = true, max_labels_count = 500, max_lines_count = 500)

offsetBars = input.int(3, "Offset Bars", minval = 1)
showPoints = input.bool(true, "Show H/L")
showLines = input.bool(true, "Show Lines")
highColor = input.color(color.red, "High / Down Color")
lowColor = input.color(color.green, "Low / Up Color")
lineWidth = input.int(2, "Line Width", minval = 1)
ema20 = ta.ema(close, 20)

isConfirmedHigh(offset) =>
    candidate = high[offset]
    result = not na(high[offset * 2]) and candidate > ema20[offset]
    for i = 0 to offset * 2
        if i != offset and high[i] > candidate
            result := false
    result

isConfirmedLow(offset) =>
    candidate = low[offset]
    result = not na(low[offset * 2]) and candidate < ema20[offset]
    for i = 0 to offset * 2
        if i != offset and low[i] < candidate
            result := false
    result

highSignal = isConfirmedHigh(offsetBars)
lowSignal = isConfirmedLow(offsetBars)

minimumDistance = offsetBars
pivotIndex = bar_index - offsetBars
highPrice = high[offsetBars]
lowPrice = low[offsetBars]

// kind: 1 = high, -1 = low. segment is the line ending at this pivot.
type PivotPoint
    int kind
    int barIndex
    float price
    label marker
    line segment

var array<PivotPoint> pivotPoints = array.new<PivotPoint>()

addPivot(array<PivotPoint> points, int kind, int barIndex, float price) =>
    labelStyle = kind == 1 ? label.style_label_down : label.style_label_up
    pointColor = kind == 1 ? highColor : lowColor
    pointText = kind == 1 ? "H" : "L"
    label marker = showPoints ? label.new(barIndex, price, pointText, style = labelStyle, color = pointColor, textcolor = color.white) : na
    line segment = na
    if showLines and array.size(points) > 0
        previous = array.last(points)
        segmentColor = kind == 1 ? lowColor : highColor
        segment := line.new(previous.barIndex, previous.price, barIndex, price, color = segmentColor, width = lineWidth)
    array.push(points, PivotPoint.new(kind, barIndex, price, marker, segment))

replaceLastPivot(PivotPoint point, int barIndex, float price) =>
    point.barIndex := barIndex
    point.price := price
    if not na(point.segment)
        line.set_xy2(point.segment, barIndex, price)
    if not na(point.marker)
        label.set_xy(point.marker, barIndex, price)

processPivot(array<PivotPoint> points, int kind, int barIndex, float price, int requiredDistance) =>
    if array.size(points) == 0
        addPivot(points, kind, barIndex, price)
    else
        lastPoint = array.last(points)
        if lastPoint.kind == kind
            isMoreExtreme = kind == 1 ? price > lastPoint.price : price < lastPoint.price
            if isMoreExtreme
                replaceLastPivot(lastPoint, barIndex, price)
        else if barIndex - lastPoint.barIndex > requiredDistance
            addPivot(points, kind, barIndex, price)

getRecentPivot(array<PivotPoint> points, int kind, int occurrence) =>
    PivotPoint result = na
    found = 0
    index = array.size(points) - 1
    while index >= 0 and found < occurrence
        point = array.get(points, index)
        if point.kind == kind
            found += 1
            if found == occurrence
                result := point
        index -= 1
    result

if highSignal
    processPivot(pivotPoints, 1, pivotIndex, highPrice, minimumDistance)

if lowSignal
    processPivot(pivotPoints, -1, pivotIndex, lowPrice, minimumDistance)
