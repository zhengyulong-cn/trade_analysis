//@version=6
indicator("HLPoint2 ZigZag", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500, max_bars_back = 5000)

minimumDistance = input.int(3, "MinimumDistance", minval = 1)
showStructureLabels = input.bool(true, "Show Structure Labels")
showLines = input.bool(true, "Show Lines")
showZones = input.bool(true, "Show Pivot Zones")
highColor = input.color(color.green, "High / Down Color")
lowColor = input.color(color.red, "Low / Up Color")
longStructureColor = input.color(color.fuchsia, "Long Structure Color")
shortStructureColor = input.color(color.blue, "Short Structure Color")
blockedStructureColor = input.color(color.orange, "Blocked Structure Color")
lineWidth = input.int(2, "Line Width", minval = 1)

zoneFillHigh = color.new(highColor, 85)
zoneFillLow = color.new(lowColor, 85)
zoneBorderHigh = color.new(highColor, 35)
zoneBorderLow = color.new(lowColor, 35)

ema20 = ta.ema(close, 20)

type PivotPoint
    int kind
    int barIndex
    float price
    // 顶点区域中轨、上轨、下轨
    float zoneCenter
    float zoneUpper
    float zoneLower
    //绘制的图形
    label marker
    line segment
    box zoneBox

var array<PivotPoint> pivotPoints = array.new<PivotPoint>()

// 确定高点：选择5根K线，最中间的那根K线最高价高于其他所有的K线
isConfirmedHigh() =>
    candidate = high[2]
    result = not na(high[4]) and candidate > ema20[2]
    for index = 0 to 4
        if index != 2 and high[index] > candidate
            result := false
    result

// 确定低点：选择5根K线，最中间的那根K线最低价低于其他所有的K线
isConfirmedLow() =>
    candidate = low[2]
    result = not na(low[4]) and candidate < ema20[2]
    for index = 0 to 4
        if index != 2 and low[index] < candidate
            result := false
    result

buildZone(int kind, int pivotBarIndex, float tolerance) =>
    pivotOffset = bar_index - pivotBarIndex
    pivotCenter = kind == 1 ? math.max(open[pivotOffset], close[pivotOffset]) : math.min(open[pivotOffset], close[pivotOffset])
    pivotUpper = kind == 1 ? high[pivotOffset] : pivotCenter + tolerance
    pivotLower = kind == 1 ? pivotCenter - tolerance : low[pivotOffset]
    [pivotCenter, pivotUpper, pivotLower]

createZoneBox(int kind, int pivotBarIndex, float zoneUpper, float zoneLower) =>
    borderColor = kind == 1 ? zoneBorderHigh : zoneBorderLow
    fillColor = kind == 1 ? zoneFillHigh : zoneFillLow
    box.new(left = math.max(pivotBarIndex - 2, 0), top = zoneUpper, right = pivotBarIndex, bottom = zoneLower, border_color = borderColor, bgcolor = fillColor)

// ---------------------结构识别---------------------
isLess(PivotPoint leftPoint, PivotPoint rightPoint) =>
    leftPoint.zoneUpper < rightPoint.zoneLower

isGreater(PivotPoint leftPoint, PivotPoint rightPoint) =>
    leftPoint.zoneLower > rightPoint.zoneUpper

isEqual(PivotPoint leftPoint, PivotPoint rightPoint) =>
    leftPoint.zoneUpper >= rightPoint.zoneLower and leftPoint.zoneLower <= rightPoint.zoneUpper

getRecentPivot(array<PivotPoint> points, int kind, int occurrence) =>
    PivotPoint result = na
    found = 0
    pointIndex = array.size(points) - 1
    while pointIndex >= 0 and found < occurrence
        point = array.get(points, pointIndex)
        if point.kind == kind
            found += 1
            if found == occurrence
                result := point
        pointIndex -= 1
    result

getRecentPivotIndex(array<PivotPoint> points, int kind, int occurrence) =>
    int result = na
    found = 0
    pointIndex = array.size(points) - 1
    while pointIndex >= 0 and found < occurrence
        point = array.get(points, pointIndex)
        if point.kind == kind
            found += 1
            if found == occurrence
                result := pointIndex
        pointIndex -= 1
    result

getLongStructureSignal(PivotPoint h1, PivotPoint h2, PivotPoint h3, PivotPoint l1, PivotPoint l2, PivotPoint l3) =>
    string labelText = ""
    l1LessL2 = isLess(l1, l2)
    l1EqualL2 = isEqual(l1, l2)
    l2LessL3 = isLess(l2, l3)
    l2EqualL3 = isEqual(l2, l3)
    h2LessH3 = isLess(h2, h3)
    h2EqualH3 = isEqual(h2, h3)
    if l1LessL2 and l2LessL3 and h2LessH3
        labelText := "L1<L2<L3 & H2<H3"
    else if l1EqualL2 and l2LessL3 and h2LessH3
        labelText := "L1=L2<L3 & H2<H3"
    else if l1LessL2 and l2EqualL3 and h2LessH3
        labelText := "L1<L2=L3 & H2<H3"
    else if l1LessL2 and l2LessL3 and h2EqualH3
        labelText := "L1<L2<L3 & H2=H3"
    else if l1EqualL2 and l2LessL3 and h2EqualH3
        labelText := "L1=L2<L3 & H2=H3"
    [labelText, -1, longStructureColor]

getShortStructureSignal(PivotPoint h1, PivotPoint h2, PivotPoint h3, PivotPoint l1, PivotPoint l2, PivotPoint l3) =>
    string labelText = ""
    h1GreaterH2 = isGreater(h1, h2)
    h1EqualH2 = isEqual(h1, h2)
    h2GreaterH3 = isGreater(h2, h3)
    h2EqualH3 = isEqual(h2, h3)
    l2GreaterL3 = isGreater(l2, l3)
    l2EqualL3 = isEqual(l2, l3)
    if h1GreaterH2 and h2GreaterH3 and l2GreaterL3
        labelText := "H1>H2>H3 & L2>L3"
    else if h1EqualH2 and h2GreaterH3 and l2GreaterL3
        labelText := "H1=H2>H3 & L2>L3"
    else if h1GreaterH2 and h2EqualH3 and l2GreaterL3
        labelText := "H1>H2=H3 & L2>L3"
    else if h1GreaterH2 and h2GreaterH3 and l2EqualL3
        labelText := "H1>H2>H3 & L2=L3"
    else if h1EqualH2 and h2GreaterH3 and l2EqualL3
        labelText := "H1=H2>H3 & L2=L3"
    [labelText, 1, shortStructureColor]

getLongBlockedStructureSignal(PivotPoint p1, PivotPoint p2, PivotPoint p3) =>
    string labelText = ""
    allEqual = isEqual(p1, p2) and isEqual(p2, p3) and isEqual(p1, p3)
    if allEqual
        labelText :=  "H1=H2=H3"
    [labelText, 1, blockedStructureColor]

getShortBlockedStructureSignal(PivotPoint p1, PivotPoint p2, PivotPoint p3) =>
    string labelText = ""
    allEqual = isEqual(p1, p2) and isEqual(p2, p3) and isEqual(p1, p3)
    if allEqual
        labelText := "L1=L2=L3"
    [labelText, -1, blockedStructureColor]

updateLatestStructureLabel(array<PivotPoint> points, string labelText, int targetKind, color labelColor) =>
    targetIndex = getRecentPivotIndex(points, targetKind, 1)
    if not na(targetIndex)
        targetPoint = array.get(points, targetIndex)
        if not na(targetPoint.marker)
            label.delete(targetPoint.marker)
        targetPoint.marker := na
        if showStructureLabels and labelText != ""
            labelStyle = targetKind == 1 ? label.style_label_down : label.style_label_up
            targetPoint.marker := label.new(targetPoint.barIndex, targetPoint.price, labelText, style = labelStyle, color = labelColor, textcolor = color.white)
        array.set(points, targetIndex, targetPoint)

refreshLatestStructureLabel(array<PivotPoint> points) =>
    currentPoint = array.last(points)
    string labelText = ""
    int targetKind = currentPoint.kind
    color labelColor = currentPoint.kind == 1 ? shortStructureColor : longStructureColor
    if array.size(points) >= 6
        h1 = getRecentPivot(points, 1, 3)
        h2 = getRecentPivot(points, 1, 2)
        h3 = getRecentPivot(points, 1, 1)
        l1 = getRecentPivot(points, -1, 3)
        l2 = getRecentPivot(points, -1, 2)
        l3 = getRecentPivot(points, -1, 1)
        if not na(h1) and not na(h2) and not na(h3) and not na(l1) and not na(l2) and not na(l3)
            [longBlockedLabelText, longBlockedTargetKind, longBlockedLabelColor] = getLongBlockedStructureSignal(h1, h2, h3)
            [shortBlockedLabelText, shortBlockedTargetKind, shortBlockedLabelColor] = getShortBlockedStructureSignal(l1, l2, l3)
            [longLabelText, longTargetKind, longLabelColor] = getLongStructureSignal(h1, h2, h3, l1, l2, l3)
            [shortLabelText, shortTargetKind, shortLabelColor] = getShortStructureSignal(h1, h2, h3, l1, l2, l3)
            if currentPoint.kind == 1
                labelText := longBlockedLabelText
                targetKind := longBlockedTargetKind
                labelColor := longBlockedLabelColor
                if shortLabelText != ""
                    labelText := shortLabelText
                    targetKind := shortTargetKind
                    labelColor := shortLabelColor
            else
                labelText := shortBlockedLabelText
                targetKind := shortBlockedTargetKind
                labelColor := shortBlockedLabelColor
                if longLabelText != ""
                    labelText := longLabelText
                    targetKind := longTargetKind
                    labelColor := longLabelColor
    updateLatestStructureLabel(points, labelText, targetKind, labelColor)


// ---------------------Pivot结点操作---------------------
addPivot(array<PivotPoint> points, int kind, int pivotBarIndex, float price, float tolerance) =>
    [zoneCenter, zoneUpper, zoneLower] = buildZone(kind, pivotBarIndex, tolerance)
    label marker = na
    line segment = na
    if showLines and array.size(points) > 0
        previousPoint = array.last(points)
        segmentColor = kind == 1 ? lowColor : highColor
        segment := line.new(previousPoint.barIndex, previousPoint.price, pivotBarIndex, price, color = segmentColor, width = lineWidth)
    box zoneBox = showZones ? createZoneBox(kind, pivotBarIndex, zoneUpper, zoneLower) : na
    array.push(points, PivotPoint.new(kind, pivotBarIndex, price, zoneCenter, zoneUpper, zoneLower, marker, segment, zoneBox))
    refreshLatestStructureLabel(points)

replaceLastPivot(array<PivotPoint> points, int pivotBarIndex, float price, float tolerance) =>
    lastPoint = points.pop()
    [zoneCenter, zoneUpper, zoneLower] = buildZone(lastPoint.kind, pivotBarIndex, tolerance)
    lastPoint.barIndex := pivotBarIndex
    lastPoint.price := price
    lastPoint.zoneCenter := zoneCenter
    lastPoint.zoneUpper := zoneUpper
    lastPoint.zoneLower := zoneLower
    if not na(lastPoint.segment)
        line.set_xy2(lastPoint.segment, pivotBarIndex, price)
    if not na(lastPoint.marker)
        label.set_xy(lastPoint.marker, pivotBarIndex, price)
    if not na(lastPoint.zoneBox)
        box.set_lefttop(lastPoint.zoneBox, math.max(pivotBarIndex - 2, 0), zoneUpper)
        box.set_rightbottom(lastPoint.zoneBox, pivotBarIndex, zoneLower)
    array.push(points, lastPoint)
    refreshLatestStructureLabel(points)

getLimitedMaxNumSwing(int distance) =>
    if distance == 0
        9
    else if distance == 1
        6
    else if distance == 2
        4
    else if distance == 3
        3
    else
        1

processPivot(array<PivotPoint> points, int kind, int barIndex, float price, int requiredDistance, float tolerance) =>
    if array.size(points) == 0
        addPivot(points, kind, barIndex, price, tolerance)
    else
        lastPoint = array.last(points)
        if lastPoint.kind == kind
            isMoreExtreme = kind == 1 ? price > lastPoint.price : price < lastPoint.price
            if isMoreExtreme
                replaceLastPivot(points, barIndex, price, tolerance)
        else
            distanceFromLastPivot = barIndex - lastPoint.barIndex
            swing = math.abs(price - lastPoint.price)
            minimumSwing = nz(tolerance, 0.0) * 1
            maxnumSwing = nz(tolerance, 0.0) * getLimitedMaxNumSwing(distanceFromLastPivot)
            if distanceFromLastPivot > requiredDistance
                if swing >= minimumSwing
                    addPivot(points, kind, barIndex, price, tolerance)
            else
                isFastReversal = not na(tolerance) and swing >= maxnumSwing
                if isFastReversal
                    addPivot(points, kind, barIndex, price, tolerance)

highSignal = isConfirmedHigh()
lowSignal = isConfirmedLow()
pivotIndex = bar_index - 2
pivotPointStdev = ta.stdev(math.abs(close - open), 500, false)[2]

if highSignal and not(lowSignal)
    processPivot(pivotPoints, 1, pivotIndex, high[2], minimumDistance, pivotPointStdev)
if not(highSignal) and lowSignal
    processPivot(pivotPoints, -1, pivotIndex, low[2], minimumDistance, pivotPointStdev)
